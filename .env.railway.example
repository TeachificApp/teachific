# Railway variables for Teachific — copy live Manus values so sign-in,
# magic links, the existing database, and AI generation keep working.
# Do not commit real secrets.

NODE_ENV=production

# Same database as Manus (TiDB). Reuse this URL so users/data stay intact.
DATABASE_URL=

# Same cookie/session secret as Manus if you want existing sessions to survive.
JWT_SECRET=

# Magic-link + transactional email (same SendGrid as Manus)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@teachific.app
SENDGRID_FROM_NAME=Teachific

# Public URLs used in magic-link and verify emails
VITE_APP_URL=https://teachific.app
VITE_SITE_URL=https://teachific.app

# Sign-in: keep Manus OAuth alongside email/password + magic link
VITE_APP_ID=
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im

# AI generation: keep Manus Forge (do not remove these)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# File storage (Manus Forge is the default; set AWS_* only if you already use S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# Payments (same Stripe account)
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

VITE_APP_TITLE=Teachific™
VITE_APP_LOGO=
