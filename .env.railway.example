# Railway variables for Teachific — Manus-independent.
# Copy into the Railway service Variables tab. Do not commit secrets.

NODE_ENV=production

# Railway MySQL plugin injects this. Do not point at Manus/TiDB.
# DATABASE_URL=

JWT_SECRET=

# Magic-link + transactional email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@teachific.app
SENDGRID_FROM_NAME=Teachific

# Public URLs used in magic-link and verify emails
VITE_APP_URL=https://teachific.app
VITE_SITE_URL=https://teachific.app

# Email/password + magic link only (no Manus OAuth)
VITE_APP_TITLE=Teachific™
VITE_APP_LOGO=

# AI generation (replaces Manus Forge)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# File storage — AWS S3 or Cloudflare R2 (required for uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# AWS_S3_PUBLIC_URL=https://cdn.teachific.app
#
# R2 alternative (used if AWS_* is unset):
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=https://cdn.teachific.app

# Payments
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
