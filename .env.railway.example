# Railway runtime / build variables for Teachific
# Copy values into the Railway service Variables tab. Do not commit secrets.

NODE_ENV=production

# Injected by the Railway MySQL plugin — do not paste a URL unless you created MySQL outside Railway
# DATABASE_URL=mysql://...

JWT_SECRET=

# AWS S3 (or set the R2 equivalents on other apps)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=teachific-files
# AWS_S3_PUBLIC_URL=https://cdn.example.com

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@teachific.app
SENDGRID_FROM_NAME=Teachific

# Vite build-time (also listed in railway.toml [build.buildArgs])
VITE_APP_ID=
VITE_APP_TITLE=Teachific™
VITE_APP_LOGO=
# Leave OAuth / Forge empty on Railway once email/password is the login path
# VITE_OAUTH_PORTAL_URL=
# VITE_FRONTEND_FORGE_API_URL=
# VITE_FRONTEND_FORGE_API_KEY=
