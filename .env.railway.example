# Railway runtime / build variables for Teachific
# Copy values into the Railway service Variables tab. Do not commit secrets.

NODE_ENV=production
VITE_APP_URL=https://teachific.app
APP_URL=https://teachific.app

# Injected by the Railway MySQL plugin — do not paste a URL unless you created MySQL outside Railway.
# DATABASE_URL=mysql://...

JWT_SECRET=

# File storage: AWS S3 or Cloudflare R2. Configure one S3-compatible bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=teachific-files
# AWS_S3_PUBLIC_URL=https://cdn.example.com

# Cloudflare R2 alternative aliases:
# CF_R2_ACCOUNT_ID=
# CF_R2_ACCESS_KEY_ID=
# CF_R2_SECRET_ACCESS_KEY=
# CF_R2_BUCKET_NAME=
# CF_R2_PUBLIC_URL=https://files.example.com

# AI services (LLM, images, TTS, transcription)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Optional direct Google Maps usage
# GOOGLE_MAPS_API_KEY=
# VITE_GOOGLE_MAPS_API_KEY=

STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@teachific.app
SENDGRID_FROM_NAME=Teachific

# Vite build-time (also listed in railway.toml [build.buildArgs])
VITE_APP_ID=
VITE_APP_TITLE=Teachific™
VITE_APP_LOGO=

# Railway-independent auth/storage defaults.
# Leave these false/empty. Enable only as a temporary bridge while cutting over legacy Manus users/data.
ENABLE_MANUS_OAUTH=false
ENABLE_LEGACY_FORGE=false
# OAUTH_SERVER_URL=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
